# Copy this file to .env and fill in your real key. .env is gitignored — never commit your real key.

# Get a free key at https://aistudio.google.com/apikey (no credit card required)
GEMINI_API_KEY=your_key_here

# "gemini-flash-latest" is an alias Google auto-updates to point at their
# current fastest free-tier-eligible Flash model, so this stays current
# without you having to edit code every time Google ships a new version.
# Check https://ai.google.dev/gemini-api/docs/models if you want to pin a
# specific version instead (e.g. for reproducibility during testing).
GEMINI_MODEL=gemini-flash-latest
